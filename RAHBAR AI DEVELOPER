@dataclass
class CodeDiagnosis:
    """ਕੋਡ ਦੀ ਜਾਂਚ ਦਾ ਨਤੀਜਾ"""
    file_path: str
    issues: List[str] = field(default_factory=list)
    suggestions: List[str] = field(default_factory=list)
    dependencies: List[str] = field(default_factory=list)
    complexity_score: float = 0.0
    quality_score: float = 0.0
    can_improve: bool = False
    
    def add_issue(self, issue: str, suggestion: str = None):
        self.issues.append(issue)
        if suggestion:
            self.suggestions.append(suggestion)
        self.can_improve = True
    
    def to_dict(self):
        return {
            'file': self.file_path,
            'issues': self.issues,
            'suggestions': self.suggestions,
            'complexity': self.complexity_score,
            'quality': self.quality_score,
            'needs_work': self.can_improve
        }


@dataclass
class LearningMemory:
    """ਸਿਖਿਆ ਹੋਈ ਗੱਲਾਂ ਯਾਦ ਰੱਖਦਾ"""
    pattern: str
    solution: str
    context: str
    timestamp: datetime = field(default_factory=datetime.now)
    success_count: int = 0
    failure_count: int = 0
    
    def apply_success(self):
        self.success_count += 1
    
    def apply_failure(self):
        self.failure_count += 1
    
    def confidence(self) -> float:
        total = self.success_count + self.failure_count
        return self.success_count / total if total > 0 else 0.5


