class DeepCodeAnalyzer:
    """ਕੋਡ ਦੀ ਡੂੰਘੀ ਜਾਂਚ ਕਰਦਾ"""
    
    def __init__(self):
        self.memory: Dict[str, LearningMemory] = {}
        self.load_memory()
    
    def load_memory(self):
        """ਪਿਛਲੀ ਸਿਖਿਆ ਲੋਡ ਕਰੋ"""
        try:
            memory_file = Path("rahbar_memory.json")
            if memory_file.exists():
                with open(memory_file, 'r') as f:
                    data = json.load(f)
                    for key, mem in data.items():
                        self.memory[key] = LearningMemory(**mem)
        except:
            pass
    
    def save_memory(self):
        """ਸਿਖਿਆ ਸੇਵ ਕਰੋ"""
        try:
            memory_file = Path("rahbar_memory.json")
            with open(memory_file, 'w') as f:
                json.dump({
                    k: {
                        'pattern': v.pattern,
                        'solution': v.solution,
                        'context': v.context,
                        'timestamp': v.timestamp.isoformat(),
                        'success_count': v.success_count,
                        'failure_count': v.failure_count
                    } for k, v in self.memory.items()
                }, f, indent=2)
        except:
            pass
    
    def analyze_file(self, file_path: str) -> CodeDiagnosis:
        """ਫ਼ਾਈਲ ਦੀ ਜਾਂਚ"""
        diagnosis = CodeDiagnosis(file_path)
        
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                content = f.read()
            
            # Basic checks
            self._check_basics(content, diagnosis)
            
            # Parse AST for deeper analysis
            try:
                tree = ast.parse(content)
                self._analyze_ast(tree, diagnosis)
            except SyntaxError as e:
                diagnosis.add_issue(f"Syntax error: {e}", "Syntax theek karo")
            
            # Check dependencies
            self._find_dependencies(content, diagnosis)
            
            # Calculate scores
            diagnosis.complexity_score = self._calculate_complexity(content)
            diagnosis.quality_score = self._calculate_quality(content, diagnosis)
            
        except Exception as e:
            diagnosis.add_issue(f"Analysis failed: {e}", "File kholo te dekho")
        
        return diagnosis
    
    def _check_basics(self, content: str, diagnosis: CodeDiagnosis):
        """ਬੁਨਿਆਦੀ ਜਾਂਚ"""
        lines = content.split('\n')
        
        # Empty file
        if len(lines) == 0 or all(l.strip() == '' for l in lines):
            diagnosis.add_issue("ਖ਼ਾਲੀ ਫ਼ਾਈਲ", "ਕੁਝ ਕੋਡ ਲਿਖੋ")
            return
        
        # Too many imports
        imports = [l for l in lines if l.strip().startswith(('import', 'from'))]
        if len(imports) > 20:
            diagnosis.add_issue("ਬਹੁਤ ਸਾਰੇ imports", "ਜ਼ਰੂਰੀ ਹੀ imports ਰੱਖੋ")
        
        # Long lines
        for i, line in enumerate(lines, 1):
            if len(line) > 120:
                diagnosis.add_issue(f"ਲਾਈਨ {i} ਬਹੁਤ ਲੰਬੀ ਹੈ", "ਛੋਟੀਆਂ ਲਾਈਨਾਂ ਬਣਾਓ")
        
        # Missing main guard
        if '__main__' in content and 'if __name__ == "__main__":' not in content:
            diagnosis.add_issue("Main guard missing", "if __name__ == '__main__': da istemal karo")
    
    def _analyze_ast(self, tree: ast.AST, diagnosis: CodeDiagnosis):
        """AST analysis"""
        # Count functions
        functions = [node for node in ast.walk(tree) if isinstance(node, ast.FunctionDef)]
        if len(functions) > 50:
            diagnosis.add_issue("ਬਹੁਤ ਸਾਰੇ functions", "Modules ਵਿੱਚ ਵੰਡੋ")
        
        # Check function lengths
        for func in functions:
            func_lines = func.end_lineno - func.lineno if func.end_lineno else 0
            if func_lines > 100:
                diagnosis.add_issue(
                    f"Function '{func.name}' ਬਹੁਤ ਲੰਬੀ ਹੈ ({func_lines} lines)",
                    "ਛੋਟੇ functions ਵਿੱਚ ਤੋੜੋ"
                )
        
        # Find try-except blocks
        for node in ast.walk(tree):
            if isinstance(node, ast.Try):
                # Check if except blocks are specific
                handlers = node.handlers
                for handler in handlers:
                    if handler.type is None:  # Bare except
                        diagnosis.add_issue(
                            "Bare except statement",
                            "Specific exceptions catch karo"
                        )
    
    def _find_dependencies(self, content: str, diagnosis: CodeDiagnosis):
        """ਜ਼ਰੂਰੀ dependencies ਲੱਭੋ"""
        imports = []
        lines = content.split('\n')
        
        for line in lines:
            line = line.strip()
            if line.startswith('import '):
                imp = line[7:].split(' as ')[0].strip()
                imports.append(imp)
            elif line.startswith('from '):
                parts = line[5:].split(' import ')
                if len(parts) == 2:
                    imports.append(parts[0].strip())
        
        diagnosis.dependencies = list(set(imports))
    
    def _calculate_complexity(self, content: str) -> float:
        """Complexity score"""
        lines = [l for l in content.split('\n') if l.strip()]
        if not lines:
            return 0.0
        
        # Simple heuristic
        score = 0.0
        score += min(content.count('if ') / len(lines), 1.0) * 0.3
        score += min(content.count('for ') / len(lines), 1.0) * 0.3
        score += min(content.count('while ') / len(lines), 1.0) * 0.2
        score += min(content.count('def ') / len(lines), 1.0) * 0.2
        
        return round(score, 2)
    
    def _calculate_quality(self, content: str, diagnosis: CodeDiagnosis) -> float:
        """Quality score"""
        base = 0.7  # Start with assumption of decent quality
        
        # Deduct for issues
        deduction = len(diagnosis.issues) * 0.05
        base -= min(deduction, 0.3)
        
        # Add for good practices
        if '__name__' in content:
            base += 0.1
        if 'try:' in content and 'except ' in content:
            base += 0.1
        if 'def ' in content and '"""' in content:  # Docstrings
            base += 0.1
        
        return round(max(0.1, min(1.0, base)), 2)
    
    def learn_from_fix(self, old_code: str, new_code: str, success: bool):
        """ਠੀਕ ਕਰਨ ਤੋਂ ਸਿੱਖੋ"""
        # Create pattern hash
        pattern_hash = hashlib.md5(old_code.encode()).hexdigest()[:16]
        
        if pattern_hash not in self.memory:
            self.memory[pattern_hash] = LearningMemory(
                pattern=old_code[:100],  # First 100 chars as pattern
                solution=new_code[:100],
                context="code_fix",
                success_count=1 if success else 0,
                failure_count=0 if success else 1
            )
        else:
            if success:
                self.memory[pattern_hash].apply_success()
            else:
                self.memory[pattern_hash].apply_failure()
        
        self.save_memory()


