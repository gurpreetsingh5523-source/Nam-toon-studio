@dataclass
class Character:
    """ਕਿਰਦਾਰ ਦਾ ਡੇਟਾ"""
    name: str
    age: int
    role: str
    color_palette: List[str]
    walk_style: str = "normal"
    
    def get_walk_offset(self, frame: int) -> float:
        """ਚੱਲਣ ਦਾ ਅਨਿੱਖੜਵਾਂ ਫੇਜ਼"""
        if self.walk_style == "normal":
            return math.sin(frame * 0.1) * 10
        elif self.walk_style == "fast":
            return math.sin(frame * 0.2) * 15
        else:
            return math.sin(frame * 0.05) * 5


