class AutoRepairEngine:
    """ਕੋਡ ਆਪਣੇ-ਆਪ ਠੀਕ ਕਰਦਾ"""
    
    REPAIR_RULES = {
        "bare_except": {
            "pattern": ["except:", "except :"],
            "fix": "except Exception as e:",
            "message": "Bare except ਨੂੰ specific ਬਣਾਇਆ"
        },
        "print_debug": {
            "pattern": ["print(", "print ("],
            "fix": "# DEBUG: print(",
            "message": "Debug print statements comment karo"
        },
        "long_function": {
            "pattern": ["def "],  # Detected by length
            "fix": None,  # Requires refactoring
            "message": "ਲੰਬੇ function ਨੂੰ ਛੋਟੇ functions ਵਿੱਚ ਵੰਡੋ"
        }
    }
    
    def __init__(self, analyzer: DeepCodeAnalyzer):
        self.analyzer = analyzer
        self.punjab_ai = PunjabAI()
    
    def repair_file(self, file_path: str) -> Tuple[bool, str, str]:
        """ਫ਼ਾਈਲ ਠੀਕ ਕਰੋ"""
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                original = f.read()
            
            repaired = original
            changes = []
            
            # Apply repair rules
            for rule_name, rule in self.REPAIR_RULES.items():
                for pattern in rule['pattern']:
                    if pattern in repaired:
                        if rule['fix']:
                            repaired = repaired.replace(pattern, rule['fix'])
                            changes.append(rule['message'])
            
            # Fix imports order
            repaired = self._organize_imports(repaired)
            
            # Add missing main guard
            if 'if __name__' not in repaired and '__main__' in repaired:
                lines = repaired.split('\n')
                for i, line in enumerate(lines):
                    if '__main__' in line:
                        # Add guard before main execution
                        lines.insert(i, '\nif __name__ == "__main__":')
                        lines.insert(i + 1, '    ' + line.strip())
                        lines[i + 2] = ''  # Clear original line
                        changes.append("Main guard ਸ਼ਾਮਲ ਕੀਤਾ")
                        repaired = '\n'.join(lines)
                        break
            
            if repaired != original:
                # Create backup
                backup_path = file_path + '.backup'
                with open(backup_path, 'w', encoding='utf-8') as f:
                    f.write(original)
                
                # Write repaired
                with open(file_path, 'w', encoding='utf-8') as f:
                    f.write(repaired)
                
                # Learn from this fix
                self.analyzer.learn_from_fix(original, repaired, True)
                
                return True, repaired, " | ".join(changes)
            
            return False, original, "ਕੋਈ ਬਦਲਾਅ ਨਹੀਂ ਚਾਹੀਦਾ"
            
        except Exception as e:
            return False, "", f"Repair failed: {e}"
    
    def _organize_imports(self, content: str) -> str:
        """Imports ਨੂੰ ਵਿਵਸਥਿਤ ਕਰੋ"""
        lines = content.split('\n')
        
        import_lines = []
        other_lines = []
        
        for line in lines:
            if line.strip().startswith(('import ', 'from ')):
                import_lines.append(line)
            else:
                other_lines.append(line)
        
        # Sort imports
        import_lines.sort()
        
        # Combine
        if import_lines:
            organized = import_lines + [''] + other_lines
            return '\n'.join(organized)
        
        return content
    
